# Backend environment. Copy to .env and fill in.
# .env is gitignored — never commit real values, including into this file.

PORT=3000
FRONTEND_URL=http://localhost:5173

# Supabase — service role key bypasses RLS. Backend only, never the frontend.
# Project settings -> API. The service_role key, not the anon key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signs the session token issued after a student signs in. Anyone holding this
# can mint a token for any student, so treat it like a password.
# Any long random string; generate with: openssl rand -base64 32
JWT_SECRET=generate-your-own

# OpenAI
OPENAI_API_KEY=sk-your-key

# Optional: defaults to gpt-4o, matching the previous system.
# gpt-4o-mini is far cheaper if exact comparability stops mattering.
OPENAI_MODEL=
